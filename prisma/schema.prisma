generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model SaleItem {
  id          String   @id @default(uuid()) @db.Uuid
  invoiceId   String   @map("invoice_id") @db.VarChar(128)
  itemId      String   @map("item_id") @db.VarChar(128)
  effectiveAt DateTime @map("effective_at") @db.Timestamptz(3)
  costPennies Int      @map("cost_pennies")
  taxRate     Decimal  @map("tax_rate") @db.Decimal(18, 8)
  ingestedAt  DateTime @default(now()) @map("ingested_at") @db.Timestamptz(3)

  @@unique([invoiceId, itemId])
  @@index([effectiveAt])
  @@map("sale_items")
}

model SaleAmendment {
  id          String   @id @default(uuid()) @db.Uuid
  sequence    BigInt   @unique @default(autoincrement())
  invoiceId   String   @map("invoice_id") @db.VarChar(128)
  itemId      String   @map("item_id") @db.VarChar(128)
  effectiveAt DateTime @map("effective_at") @db.Timestamptz(3)
  costPennies Int      @map("cost_pennies")
  taxRate     Decimal  @map("tax_rate") @db.Decimal(18, 8)
  ingestedAt  DateTime @default(now()) @map("ingested_at") @db.Timestamptz(3)

  @@index([invoiceId, itemId, effectiveAt, sequence])
  @@map("sale_amendments")
}

model TaxPayment {
  id            String   @id @default(uuid()) @db.Uuid
  sequence      BigInt   @unique @default(autoincrement())
  effectiveAt   DateTime @map("effective_at") @db.Timestamptz(3)
  amountPennies Int      @map("amount_pennies")
  ingestedAt    DateTime @default(now()) @map("ingested_at") @db.Timestamptz(3)

  @@index([effectiveAt])
  @@map("tax_payments")
}
